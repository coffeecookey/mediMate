# Copy this file to .env in the same folder and fill in real values.
# .env is gitignored; env.example is the checked-in reference.

# Port the backend listens on
PORT=4000

# MongoDB connection string (the app appends "/Medimate" as the database name)
MONGODB_URI=your_mongoDB_URI

# Secret used to sign/verify JWTs issued on login
JWT_SECRET=your_jwt_secret_key

# Cloudinary credentials (doctor image uploads)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret

# Hugging Face access token (free): https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_access_token_here

# Optional: override the default chat model used for symptom triage.
# Must support chatCompletion via Hugging Face Inference Providers.
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
